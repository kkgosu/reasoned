<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ListView
        android:id="@+id/graph_search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@color/border"
        android:dividerHeight="1dp"
        android:drawSelectorOnTop="true"
        android:listSelector="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/graph_search_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:accessibilityLiveRegion="polite"
        android:gravity="top|start"
        android:padding="@dimen/space_24"
        android:text="@string/graph_no_matches"
        android:textAppearance="@style/TextAppearance.Harness"
        android:visibility="gone" />
</FrameLayout>
