<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reference_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|start"
            android:text="@string/type_title_label"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <TextView
            android:id="@+id/title_sample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/type_title_sample"
            android:textAppearance="@style/TextAppearance.Harness.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical|start"
            android:text="@string/type_prose_label"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <TextView
            android:id="@+id/prose_sample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/type_prose_sample"
            android:textAppearance="@style/TextAppearance.Harness.Prose"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical|start"
            android:text="@string/type_ui_label"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <TextView
            android:id="@+id/ui_sample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/type_ui_sample"
            android:textAppearance="@style/TextAppearance.Harness" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical|start"
            android:text="@string/surface_label"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/surface_outline"
            android:padding="@dimen/space_16"
            android:text="@string/surface_sample"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical|start"
            android:text="@string/type_scale_label"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/type_scale_11"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/type_scale_12_5"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/type_scale_14"
            android:textAppearance="@style/TextAppearance.Harness" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/type_scale_16"
            android:textAppearance="@style/TextAppearance.Harness.Prose" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:fontFamily="@font/prose"
            android:text="@string/type_scale_20"
            android:textColor="@color/foreground"
            android:textSize="@dimen/text_20" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/type_scale_25"
            android:textAppearance="@style/TextAppearance.Harness.Toolbar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/type_scale_32"
            android:textAppearance="@style/TextAppearance.Harness.Title" />

        <EditText
            android:id="@+id/draft_sample"
            style="@style/Widget.Harness.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:hint="@string/draft_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine" />

        <Button
            android:id="@+id/return_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/return_home" />
    </LinearLayout>
</ScrollView>
