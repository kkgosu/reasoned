<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/graph_detail_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <TextView
            android:id="@+id/graph_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <TextView
            android:id="@+id/graph_statement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Harness.Toolbar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/graph_reasoning"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <TextView
            android:id="@+id/graph_reasoning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:lineSpacingMultiplier="1.5"
            android:textAppearance="@style/TextAppearance.Harness.Prose"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/graph_provenance"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <TextView
            android:id="@+id/graph_provenance_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/graph_fixture_source"
            android:textAppearance="@style/TextAppearance.Harness.Prose" />

        <LinearLayout
            android:id="@+id/graph_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/graph_open_lesson"
            style="@style/Widget.Harness.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/open_sample_lesson"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/graph_relationships"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <LinearLayout
            android:id="@+id/graph_related"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
