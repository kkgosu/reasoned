<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/knowledge_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:textAppearance="@style/TextAppearance.Harness.Meta"
        android:visibility="gone" />

    <Button
        android:id="@+id/graph_search_open"
        style="@style/Widget.Harness.Navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_16"
        android:background="@drawable/search_bar_background"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="@dimen/space_16"
        android:minHeight="56dp"
        android:text="@string/graph_search" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.kkgosu.learnharness.ui.views.KnowledgeGraphView
            android:id="@+id/knowledge_graph"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/graph_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="top|start"
            android:paddingHorizontal="@dimen/space_24"
            android:text="@string/graph_loading"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <Button
            android:id="@+id/graph_details"
            style="@style/Widget.Harness.Button.Secondary"
            android:gravity="center_vertical|start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:alpha="0"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawablePadding="@dimen/space_8"
            android:ellipsize="end"
            android:enabled="false"
            android:fontFamily="@font/prose"
            android:maxWidth="240dp"
            android:maxLines="2"
            android:stateListAnimator="@null"
            android:textSize="@dimen/text_14"
            android:visibility="invisible" />
    </FrameLayout>
</LinearLayout>
