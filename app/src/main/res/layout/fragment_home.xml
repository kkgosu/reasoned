<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Harness.Label"
            android:text="@string/knowledge_graph_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Harness.Title"
            android:text="@string/home_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:textAppearance="@style/TextAppearance.Harness.Prose"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/home_empty" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:textAppearance="@style/TextAppearance.Harness.Meta"
            android:text="@string/foundation_status" />

        <Button
            android:id="@+id/style_reference"
            style="@style/Widget.Harness.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/style_reference" />
    </LinearLayout>
</ScrollView>
