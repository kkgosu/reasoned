<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingVertical="@dimen/space_24">

        <TextView
            android:id="@+id/session_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <Button
            android:id="@+id/session_settings"
            style="@style/Widget.Harness.Navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_session_change" />

        <RadioGroup
            android:id="@+id/session_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:checkedButton="@id/session_learn"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/session_learn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/session_learning" />

            <RadioButton
                android:id="@+id/session_practice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/session_practice" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/session_mechanic_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/runtime_mechanic"
                android:textAppearance="@style/TextAppearance.Harness.Meta" />

            <RadioGroup
                android:id="@+id/session_mechanic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@id/mechanic_choice"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/mechanic_choice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/runtime_mechanic_choice" />

                <RadioButton
                    android:id="@+id/mechanic_recall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/runtime_mechanic_recall" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/practice_targets"
            style="@style/Widget.Harness.Navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/practice_targets_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:text="@string/practice_targets_note"
            android:textAppearance="@style/TextAppearance.Harness.Meta"
            android:visibility="gone" />

        <TextView
            android:id="@+id/runtime_goal_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_24"
            android:labelFor="@id/runtime_goal"
            android:text="@string/new_session_intro"
            android:textAppearance="@style/TextAppearance.Harness.Title" />

        <EditText
            android:id="@+id/runtime_goal"
            style="@style/Widget.Harness.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/runtime_goal_hint"
            android:maxLines="6"
            android:minLines="3" />

        <CheckBox
            android:id="@+id/session_research"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/research_allow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:text="@string/new_session_research_notice"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <Button
            android:id="@+id/runtime_start"
            style="@style/Widget.Harness.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/runtime_create" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/new_session_local"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <TextView
            android:id="@+id/session_create_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_16"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />
    </LinearLayout>
</ScrollView>
