<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingVertical="@dimen/space_24" android:focusableInTouchMode="true">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_24"
            android:textAppearance="@style/TextAppearance.Harness.Meta" android:text="@string/provider_intro" />
        <RadioGroup android:id="@+id/runtime_billing" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16" android:orientation="vertical" android:checkedButton="@id/runtime_use_api">
            <RadioButton android:id="@+id/runtime_use_chatgpt" style="@style/Widget.Harness.BillingChoice" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/chatgpt_use_plan" />
            <RadioButton android:id="@+id/runtime_use_api" style="@style/Widget.Harness.BillingChoice" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/chatgpt_use_api" />
        </RadioGroup>
        <LinearLayout android:id="@+id/runtime_chatgpt_fields" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/runtime_chatgpt_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_16" android:layout_marginBottom="@dimen/space_16"
                android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.Harness.Meta" />
            <Button android:id="@+id/runtime_chatgpt_sign_in" style="@style/Widget.Harness.Button" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_24" android:text="@string/chatgpt_continue" />
            <Button android:id="@+id/runtime_chatgpt_account" style="@style/Widget.Harness.Button.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_8" android:text="@string/chatgpt_accounts" />
            <Button android:id="@+id/runtime_chatgpt_add" style="@style/Widget.Harness.Button.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_8" android:text="@string/chatgpt_add_account" />
            <Button android:id="@+id/runtime_chatgpt_usage" style="@style/Widget.Harness.Navigation" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/chatgpt_manage_usage" />
        </LinearLayout>
        <LinearLayout android:id="@+id/runtime_api_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/runtime_key_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_24" android:labelFor="@id/runtime_key" android:text="@string/runtime_key" />
            <EditText android:id="@+id/runtime_key" style="@style/Widget.Harness.Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_8"
                android:inputType="textPassword" android:gravity="center_vertical" android:singleLine="true" android:maxLength="512"
                android:saveEnabled="false" android:importantForAutofill="no" android:hint="@string/runtime_key_hint" />
            <TextView android:id="@+id/runtime_key_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_8" android:textAppearance="@style/TextAppearance.Harness.Meta" />
            <Button android:id="@+id/runtime_save_key" style="@style/Widget.Harness.Button" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_16" android:text="@string/runtime_save_key" />
            <Button android:id="@+id/runtime_forget_key" style="@style/Widget.Harness.Navigation" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/runtime_forget_key" />
        </LinearLayout>
        <TextView android:id="@+id/runtime_model_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_24" android:labelFor="@id/runtime_model" android:text="@string/runtime_model" />
        <EditText android:id="@+id/runtime_model" style="@style/Widget.Harness.Input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_8"
            android:inputType="textVisiblePassword" android:singleLine="true" android:gravity="center_vertical" android:maxLength="100" android:hint="@string/runtime_model_hint" />
        <Button android:id="@+id/runtime_save_model" style="@style/Widget.Harness.Button.Secondary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_8" android:text="@string/provider_save_model" />
        <RadioGroup android:id="@+id/runtime_chatgpt_model_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:saveEnabled="false" android:visibility="gone" />
        <Button android:id="@+id/runtime_chatgpt_models" style="@style/Widget.Harness.Button.Secondary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_8" android:visibility="gone" android:text="@string/chatgpt_refresh_models" />
        <TextView android:id="@+id/runtime_setup_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24" android:layout_marginTop="@dimen/space_16" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.Harness.Meta" />
        <LinearLayout android:id="@+id/runtime_chatgpt_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <Button android:id="@id/chatgpt_sign_out" style="@style/Widget.Harness.Navigation" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/chatgpt_sign_out" />
            <Button android:id="@id/chatgpt_reset" style="@style/Widget.Harness.Navigation" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/chatgpt_reset" />
            <TextView android:id="@+id/chatgpt_reset_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24" android:layout_marginBottom="@dimen/space_16"
                android:textAppearance="@style/TextAppearance.Harness.Meta" android:text="@string/chatgpt_reset_summary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
