<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingVertical="@dimen/space_24">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:text="@string/provider_intro"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/provider_connection"
            android:textAppearance="@style/TextAppearance.Harness.Title" />

        <Button
            android:id="@+id/runtime_provider"
            style="@style/Widget.Harness.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical|start"
            android:text="@string/provider_choose" />

        <TextView
            android:id="@+id/runtime_provider_docs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_8"
            android:background="?android:attr/selectableItemBackground"
            android:paddingVertical="@dimen/space_8"
            android:text="@string/provider_docs"
            android:textAppearance="@style/TextAppearance.Harness.Meta"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/runtime_chatgpt_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/runtime_chatgpt_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_16"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Harness.Meta" />

            <Button
                android:id="@+id/runtime_chatgpt_sign_in"
                style="@style/Widget.Harness.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:text="@string/chatgpt_continue" />

            <Button
                android:id="@+id/runtime_chatgpt_account"
                style="@style/Widget.Harness.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical|start"
                android:text="@string/chatgpt_accounts" />

            <Button
                android:id="@+id/runtime_chatgpt_add"
                style="@style/Widget.Harness.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/chatgpt_add_account" />

            <Button
                android:id="@+id/runtime_chatgpt_usage"
                style="@style/Widget.Harness.Navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/chatgpt_manage_usage" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/runtime_api_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/runtime_key_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center_vertical|start"
                android:labelFor="@id/runtime_key"
                android:text="@string/runtime_key" />

            <EditText
                android:id="@+id/runtime_key"
                style="@style/Widget.Harness.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical|start"
                android:hint="@string/runtime_key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLength="512"
                android:saveEnabled="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/runtime_key_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/provider_key_note"
                android:textAppearance="@style/TextAppearance.Harness.Meta" />

            <TextView
                android:id="@+id/runtime_key_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_8"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Harness.Meta" />

            <Button
                android:id="@+id/runtime_save_key"
                style="@style/Widget.Harness.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/runtime_save_key" />

            <Button
                android:id="@+id/runtime_forget_key"
                style="@style/Widget.Harness.Navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/runtime_forget_key" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/runtime_custom_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/runtime_custom_url_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_24"
                android:labelFor="@id/runtime_custom_url"
                android:text="@string/provider_custom_url" />

            <EditText
                android:id="@+id/runtime_custom_url"
                style="@style/Widget.Harness.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical|start"
                android:hint="@string/provider_custom_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLength="300"
                android:singleLine="true" />

            <CheckBox
                android:id="@+id/runtime_custom_keyless"
                style="@style/Widget.Harness.BillingChoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/provider_custom_keyless" />

            <Button
                android:id="@+id/runtime_custom_save"
                style="@style/Widget.Harness.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/provider_custom_save" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/provider_custom_note"
                android:textAppearance="@style/TextAppearance.Harness.Meta" />
        </LinearLayout>

        <TextView
            android:id="@+id/runtime_model_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical|start"
            android:labelFor="@id/runtime_model"
            android:text="@string/runtime_model" />

        <Button
            android:id="@+id/runtime_model"
            style="@style/Widget.Harness.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical|start"
            android:text="@string/provider_model_none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/provider_model_note"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <TextView
            android:id="@+id/runtime_setup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_16"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical|start"
            android:text="@string/research_settings"
            android:textAppearance="@style/TextAppearance.Harness.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:text="@string/research_key_note"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <EditText
            android:id="@+id/research_key"
            style="@style/Widget.Harness.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center_vertical|start"
            android:hint="@string/research_key_hint"
            android:importantForAutofill="noExcludeDescendants"
            android:inputType="textPassword"
            android:maxLength="512"
            android:saveEnabled="false"
            android:singleLine="true" />

        <Button
            android:id="@+id/research_save_key"
            style="@style/Widget.Harness.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/research_save_key" />

        <Button
            android:id="@+id/research_forget_key"
            style="@style/Widget.Harness.Navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/research_forget_key" />

        <TextView
            android:id="@+id/research_key_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_24"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <LinearLayout
            android:id="@+id/runtime_chatgpt_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@id/chatgpt_sign_out"
                style="@style/Widget.Harness.Navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chatgpt_sign_out" />

            <Button
                android:id="@id/chatgpt_reset"
                style="@style/Widget.Harness.Navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chatgpt_reset" />

            <TextView
                android:id="@+id/chatgpt_reset_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_16"
                android:text="@string/chatgpt_reset_summary"
                android:textAppearance="@style/TextAppearance.Harness.Meta" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
