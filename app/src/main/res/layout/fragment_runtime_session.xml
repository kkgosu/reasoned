<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">

    <TextView
        android:id="@+id/lesson_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.Harness.Label" />

    <TextView
        android:id="@+id/knowledge_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_8"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"
        android:textAppearance="@style/TextAppearance.Harness.Meta" />

    <me.grishka.appkit.views.UsableRecyclerView
        android:id="@+id/lesson_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <LinearLayout
        android:id="@+id/question_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:padding="@dimen/space_12"
        android:background="@drawable/surface_outline"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.Harness.Label"
                android:text="@string/runtime_question" />
            <Button
                android:id="@+id/collapse_question"
                style="@style/Widget.Harness.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/read_lesson" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/question_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/question_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Harness.Prose"
                    android:lineSpacingMultiplier="1.5"
                    android:textIsSelectable="true" />
                <RadioGroup
                    android:id="@+id/question_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="vertical">
                    <RadioButton android:id="@+id/option_left" style="@style/Widget.Harness.Choice" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <RadioButton android:id="@+id/option_right" style="@style/Widget.Harness.Choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" />
                    <RadioButton android:id="@+id/option_stay" style="@style/Widget.Harness.Choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" />
                    <RadioButton android:id="@+id/option_unknown" style="@style/Widget.Harness.Choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" />
                </RadioGroup>
                <TextView
                    android:id="@+id/confidence_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:labelFor="@id/question_confidence"
                    android:textAppearance="@style/TextAppearance.Harness.Label" />
                <SeekBar
                    android:id="@+id/question_confidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:max="5"
                    android:progress="3"
                    android:progressTint="@color/foreground"
                    android:thumbTint="@color/foreground"
                    android:contentDescription="@string/runtime_confidence_steps" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock_shell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        android:padding="@dimen/space_8"
        android:orientation="vertical"
        android:background="@drawable/composer_background">
        <Button
            android:id="@+id/reveal_question"
            style="@style/Widget.Harness.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resume_question"
            android:visibility="gone" />
        <EditText
            android:id="@+id/question_thinking"
            style="@style/Widget.Harness.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minLines="1"
            android:maxLines="4"
            android:gravity="center_vertical|start"
            android:hint="@string/runtime_answer_hint"
            android:visibility="gone" />
        <EditText
            android:id="@+id/lesson_composer"
            style="@style/Widget.Harness.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minLines="1"
            android:maxLines="4"
            android:gravity="center_vertical|start"
            android:hint="@string/runtime_composer_hint" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical">
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                    <Button android:id="@+id/session_model" style="@style/Widget.Harness.Button.Composer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:maxLines="1" android:ellipsize="end" android:text="@string/runtime_model" />
                    <Button android:id="@+id/session_thinking" style="@style/Widget.Harness.Button.Composer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/runtime_thinking_auto" />
                </LinearLayout>
            </HorizontalScrollView>
            <FrameLayout android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target">
                <ProgressBar
                    android:id="@+id/context_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:rotation="-90"
                    android:indeterminate="false"
                    android:max="100"
                    android:progressDrawable="@drawable/context_progress"
                    android:importantForAccessibility="no" />
                <Button
                    android:id="@+id/session_context"
                    style="@style/Widget.Harness.Button.Composer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="0dp"
                    android:textSize="@dimen/text_11"
                    android:text="?"
                    android:contentDescription="@string/runtime_context" />
            </FrameLayout>
            <Button
                android:id="@+id/composer_action"
                style="@style/Widget.Harness.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/touch_target"
                android:layout_marginStart="@dimen/space_8"
                android:text="@string/runtime_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
