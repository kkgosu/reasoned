<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigation_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/background"
        android:elevation="8dp"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_24"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Harness.Toolbar" />

        <Button
            android:id="@+id/drawer_new_session"
            style="@style/Widget.Harness.Navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_session" />

        <Button
            android:id="@+id/drawer_graph"
            style="@style/Widget.Harness.Navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/navigation_graph" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingStart="@dimen/space_24"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:paddingBottom="@dimen/space_8"
            android:text="@string/navigation_sessions"
            android:textAppearance="@style/TextAppearance.Harness.Label" />

        <TextView
            android:id="@+id/drawer_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:padding="@dimen/space_24"
            android:textAppearance="@style/TextAppearance.Harness.Meta"
            android:visibility="gone" />

        <ListView
            android:id="@+id/drawer_sessions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:choiceMode="singleChoice"
            android:divider="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <Button
            android:id="@+id/drawer_settings"
            style="@style/Widget.Harness.Navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
