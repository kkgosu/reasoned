<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_24">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/transfer_notice" android:textAppearance="@style/TextAppearance.Harness.Meta" />
        <Button android:id="@+id/transfer_choose" style="@style/Widget.Harness.Button.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16" android:text="@string/transfer_choose" />
        <Button android:id="@+id/transfer_export" style="@style/Widget.Harness.Button.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16" android:text="@string/transfer_export" />
        <TextView android:id="@+id/transfer_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16" android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Harness.Prose" android:textIsSelectable="true" />
        <LinearLayout android:id="@+id/transfer_conflicts" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button android:id="@+id/transfer_install" style="@style/Widget.Harness.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
            android:text="@string/transfer_install" />
        <Button android:id="@+id/transfer_open" style="@style/Widget.Harness.Button.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
            android:layout_marginTop="@dimen/space_16" android:text="@string/transfer_open" />
    </LinearLayout>
</ScrollView>
