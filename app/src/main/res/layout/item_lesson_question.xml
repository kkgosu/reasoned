<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_24"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_16">

    <TextView
        android:id="@+id/item_answer_label"
        android:gravity="center_vertical|start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Harness.Label" />

    <TextView
        android:id="@+id/item_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:lineSpacingMultiplier="1.5"
        android:textAppearance="@style/TextAppearance.Harness.Prose"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/item_thinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:lineSpacingMultiplier="1.5"
        android:textAppearance="@style/TextAppearance.Harness.Prose"
        android:textIsSelectable="true" />
</LinearLayout>
