<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/surface_outline" />
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface" />
            <stroke android:width="2dp" android:color="@color/foreground" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/muted_foreground" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
</selector>
