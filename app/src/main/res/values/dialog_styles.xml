<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native AlertDialog, following Mastodon's rounded Material dialog treatment. -->
    <style name="Theme.Harness.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:dialogPreferredPadding">@dimen/space_24</item>
        <item name="android:windowTitleStyle">@style/Widget.Harness.DialogTitle</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/muted_foreground</item>
        <item name="android:colorAccent">@color/foreground</item>
        <item name="android:colorControlNormal">@color/muted_foreground</item>
        <item name="android:buttonBarStyle">@style/Widget.Harness.DialogButtonBar</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Harness.DialogButton</item>
        <item name="android:buttonStyle">@style/Widget.Harness.DialogButton</item>
    </style>
    <style name="Widget.Harness.DialogTitle" parent="android:Widget.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:singleLine">false</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:gravity">bottom</item>
    </style>
    <style name="Widget.Harness.DialogButtonBar" parent="android:Widget.Material.ButtonBar">
        <item name="android:padding">@dimen/space_16</item>
    </style>
    <style name="Widget.Harness.DialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
        <item name="android:background">@drawable/dialog_button</item>
    </style>
</resources>
