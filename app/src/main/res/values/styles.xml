<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Harness" parent="android:TextAppearance.Material.Body1">
        <item name="android:fontFamily">@font/ui</item>
        <item name="android:textSize">@dimen/text_14</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:fontFeatureSettings">liga</item>
    </style>
    <style name="TextAppearance.Harness.Label">
        <item name="android:textSize">@dimen/text_11</item>
        <item name="android:textColor">@color/muted_foreground</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="TextAppearance.Harness.Meta">
        <item name="android:textSize">@dimen/text_12_5</item>
        <item name="android:textColor">@color/muted_foreground</item>
    </style>
    <style name="TextAppearance.Harness.Prose">
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/prose</item>
        <item name="android:textSize">@dimen/text_16</item>
    </style>
    <style name="TextAppearance.Harness.Title">
        <item name="android:fontFamily">@font/title</item>
        <item name="android:textSize">@dimen/text_32</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Harness.Toolbar">
        <item name="android:fontFamily">@font/title</item>
        <item name="android:textSize">@dimen/text_25</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Harness.TextView" parent="android:Widget.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Harness</item>
    </style>
    <style name="Widget.Harness.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:fontFamily">@font/ui</item>
        <item name="android:textSize">@dimen/text_12_5</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_foreground</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:stateListAnimator">@animator/button_state</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
    </style>
    <style name="Widget.Harness.Button.Secondary">
        <item name="android:textColor">@color/foreground</item>
        <item name="android:background">@drawable/button_secondary</item>
    </style>
    <style name="Widget.Harness.Button.Composer" parent="Widget.Harness.Button.Secondary">
        <item name="android:background">@drawable/button_composer</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="Widget.Harness.Disclosure" parent="Widget.Harness.Button.Secondary">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textAppearance">@style/TextAppearance.Harness.Label</item>
        <item name="android:textSize">@dimen/text_11</item>
        <item name="android:textColor">@color/muted_foreground</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>
    <style name="Widget.Harness.Navigation" parent="Widget.Harness.Button.Secondary">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textSize">@dimen/text_14</item>
        <item name="android:paddingStart">@dimen/space_24</item>
        <item name="android:paddingEnd">@dimen/space_24</item>
        <item name="android:paddingTop">@dimen/space_16</item>
        <item name="android:paddingBottom">@dimen/space_16</item>
    </style>
    <style name="Widget.Harness.BillingChoice" parent="Widget.Harness.Choice">
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:fontFamily">@font/ui</item>
        <item name="android:textSize">@dimen/text_14</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:button">@drawable/radio_indicator_inset</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">@dimen/space_24</item>
        <item name="android:paddingTop">@dimen/space_12</item>
        <item name="android:paddingBottom">@dimen/space_12</item>
    </style>
    <style name="Widget.Harness.Input" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/prose</item>
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textColorHint">@color/muted_foreground</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:padding">@dimen/space_8</item>
        <item name="android:gravity">top|start</item>
        <item name="android:inputType">textCapSentences|textMultiLine</item>
        <item name="android:maxLength">2000</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Widget.Harness.MultiChoice" parent="android:Widget.CompoundButton.CheckBox">
        <item name="android:fontFamily">@font/prose</item>
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:buttonTint">@color/foreground</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:padding">@dimen/space_8</item>
    </style>

    <style name="Widget.Harness.Choice" parent="android:Widget.CompoundButton.RadioButton">
        <item name="android:fontFamily">@font/prose</item>
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:buttonTint">@color/foreground</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:padding">@dimen/space_8</item>
    </style>
</resources>
