<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppKit uses platform widgets, not the Material Components library. -->
    <style name="Theme.Reasoned" parent="Theme.AppKit">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorForeground">@color/foreground</item>
        <item name="android:colorPrimary">@color/background</item>
        <item name="android:colorPrimaryDark">@color/background</item>
        <item name="android:colorAccent">@color/foreground</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/muted_foreground</item>
        <item name="android:textColorHint">@color/muted_foreground</item>
        <item name="android:colorControlNormal">@color/muted_foreground</item>
        <!-- Material's native navigation background has a fixed circular ripple, unlike Widget.Toolbar. -->
        <item name="android:toolbarStyle">@android:style/Widget.Material.Toolbar</item>
        <item name="android:actionBarItemBackground">@drawable/button_icon</item>
        <item name="android:actionOverflowButtonStyle">@style/Widget.Harness.OverflowButton</item>
        <item name="android:actionModeCloseButtonStyle">@style/Widget.Harness.ActionModeClose</item>
        <item name="android:textViewStyle">@style/Widget.Harness.TextView</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:titleTextAppearance">@style/TextAppearance.Harness.Toolbar</item>
        <item name="android:buttonStyle">@style/Widget.Harness.Button</item>
        <item name="android:alertDialogTheme">@style/Theme.Harness.Dialog</item>
        <item name="appkitToolbarBackground">@color/background</item>
        <item name="appkitToolbarElevation">0dp</item>
        <item name="actionBarIconTint">@color/muted_foreground</item>
    </style>
</resources>
